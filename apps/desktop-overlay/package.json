{
  "name": "@scarline/desktop-overlay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron dist/main.js",
    "start": "electron dist/main.js",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@scarline/contracts": "0.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "electron": "43.4.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
