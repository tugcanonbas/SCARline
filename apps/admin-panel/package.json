{
  "name": "@scarline/admin-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "sync": "svelte-kit sync",
    "build": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "start": "node build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "widgets:build-css": "node scripts/build-widgets-css.mjs",
    "widgets:check-css": "node scripts/build-widgets-css.mjs --check"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@scarline/contracts": "0.0.0",
    "lucide-svelte": "0.475.0",
    "svelte": "5.56.10",
    "tailwindcss": "4.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.0.12",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "22.13.10",
    "svelte-check": "4.7.6",
    "tsx": "4.23.12",
    "typescript": "5.8.2",
    "vite": "6.4.3"
  }
}
