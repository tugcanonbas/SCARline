{
  "name": "@scarline/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line interface for SCARline",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "bin": {
    "scarline": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-executable.mjs",
    "dev": "node --import tsx src/index.ts",
    "prepack": "npm run build",
    "test": "npm run build && node --import tsx --test test/cli.test.ts test/lifecycle.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@scarline/contracts": "0.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
