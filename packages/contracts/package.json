{
  "name": "@scarline/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared runtime and wire contracts for SCARline",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./dist/json-schema/*.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate-json-schemas.mjs",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
