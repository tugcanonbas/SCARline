{
  "key": "camera",
  "name": "Camera and Face Features",
  "version": "1.0.0",
  "deviceType": "camera",
  "platforms": ["linux", "darwin", "win32"],
  "capabilities": [
    "camera.frames",
    "camera.local-recording",
    "face.blink",
    "face.gaze",
    "face.head-pose",
    "face.yawn",
    "face.eyebrow-distance"
  ],
  "configurationSchema": {
    "type": "object",
    "properties": {
      "cameraIndex": { "type": "integer", "minimum": 0 },
      "recording": { "type": "boolean" },
      "earThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
      "consecFrames": { "type": "integer", "minimum": 1 },
      "yawnThreshold": { "type": "number", "minimum": 0 }
    }
  },
  "channels": [
    {
      "key": "camera",
      "name": "Camera status",
      "modality": "camera",
      "unit": null,
      "sampleRate": 30,
      "configurationSchema": {}
    },
    {
      "key": "blink",
      "name": "Blink and facial features",
      "modality": "attention",
      "unit": null,
      "sampleRate": 10,
      "configurationSchema": {}
    },
    {
      "key": "gaze",
      "name": "Gaze estimation",
      "modality": "attention",
      "unit": null,
      "sampleRate": 10,
      "configurationSchema": {}
    }
  ],
  "optionalDependency": "camera",
  "mock": false
}
