{
  "name": "@scarline/core-api",
  "version": "0.0.0",
  "private": true,
  "description": "SCARline control-plane API",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.0",
    "@scarline/contracts": "0.0.0",
    "amqplib": "^0.10.9",
    "archiver": "^7.0.1",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "^6.1.0",
    "jose": "^6.2.10",
    "pg": "^8.16.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/archiver": "^7.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
