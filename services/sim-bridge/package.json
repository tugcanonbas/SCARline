{
  "name": "@scarline/sim-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "SCARline simulator command and telemetry bridge",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@scarline/contracts": "0.0.0",
    "amqplib": "^0.10.9",
    "fastify": "^5.6.2",
    "ws": "^8.18.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
