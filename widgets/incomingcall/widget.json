{
  "id": "incomingcall",
  "name": "Incoming Call",
  "description": "Displays an incoming call notification with caller details.",
  "version": "1.0.0",
  "category": "communication",
  "entry": "index.html",
  "bindings": [
    { "key": "call.callerName", "type": "string", "label": "Caller Name" },
    { "key": "call.callerPhone", "type": "string", "label": "Caller Phone" },
    { "key": "call.callerAvatar", "type": "string", "label": "Caller Avatar" },
    { "key": "call.ringDuration", "type": "number", "label": "Ring Duration", "unit": "s" }
  ],
  "triggers": [
    { "action": "show", "description": "Shows the ringing state." },
    { "action": "hide", "description": "Hides the call notification." }
  ],
  "ui": { "minWidth": 300, "minHeight": 200, "preferredWidth": 400, "preferredHeight": 300 }
}
