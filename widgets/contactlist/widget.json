{
  "id": "contactlist",
  "name": "Contact List",
  "description": "Displays a scrollable in-vehicle contact list.",
  "version": "1.0.0",
  "category": "communication",
  "entry": "index.html",
  "bindings": [
    { "key": "contacts.list", "type": "array", "label": "Contacts", "description": "Array of contact objects." },
    { "key": "contacts.selectedIndex", "type": "number", "label": "Selected Index", "description": "Highlighted contact index." }
  ],
  "triggers": [
    { "action": "show", "description": "Shows the contact list." },
    { "action": "update", "description": "Updates list selection." }
  ],
  "ui": { "minWidth": 250, "minHeight": 300, "preferredWidth": 350, "preferredHeight": 500 }
}
