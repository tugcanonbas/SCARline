{
  "id": "avatar",
  "name": "User Avatar",
  "description": "Displays the participant or simulated user's avatar.",
  "version": "1.0.0",
  "category": "general",
  "entry": "index.html",
  "bindings": [
    { "key": "user.name", "type": "string", "label": "User Name" },
    { "key": "user.avatar", "type": "string", "label": "Avatar" }
  ],
  "triggers": [
    { "action": "highlight", "description": "Highlights the avatar." }
  ],
  "ui": { "minWidth": 60, "minHeight": 60, "preferredWidth": 100, "preferredHeight": 100 }
}
