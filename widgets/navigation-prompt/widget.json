{
  "id": "navigation-prompt",
  "name": "Navigation Prompt",
  "description": "Shows a single upcoming navigation instruction.",
  "version": "1.0.0",
  "category": "driving",
  "entry": "index.html",
  "bindings": [
    {
      "key": "navigation.instruction",
      "type": "string",
      "label": "Instruction",
      "description": "Prompt text to show."
    },
    {
      "key": "navigation.distance",
      "type": "number",
      "label": "Distance",
      "unit": "m",
      "description": "Distance until maneuver."
    },
    {
      "key": "navigation.direction",
      "type": "string",
      "label": "Direction",
      "description": "Direction identifier for the next maneuver."
    },
    {
      "key": "navigation.roadName",
      "type": "string",
      "label": "Road Name",
      "description": "Road name for the next maneuver."
    }
  ],
  "triggers": [
    {
      "action": "show",
      "description": "Makes the prompt visible."
    }
  ],
  "ui": {
    "minWidth": 280,
    "minHeight": 160,
    "preferredWidth": 460,
    "preferredHeight": 220
  }
}
