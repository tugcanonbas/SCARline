{
  "id": "outgoingcall",
  "name": "Outgoing Call",
  "description": "Displays an outgoing call and dialing duration.",
  "version": "1.0.0",
  "category": "communication",
  "entry": "index.html",
  "bindings": [
    { "key": "call.calleeName", "type": "string", "label": "Callee Name" },
    { "key": "call.calleePhone", "type": "string", "label": "Callee Phone" },
    { "key": "call.dialDuration", "type": "number", "label": "Dial Duration", "unit": "s" }
  ],
  "triggers": [
    { "action": "show", "description": "Shows outgoing call state." },
    { "action": "hide", "description": "Hides outgoing call state." }
  ],
  "ui": { "minWidth": 300, "minHeight": 200, "preferredWidth": 400, "preferredHeight": 300 }
}
