{
  "id": "music",
  "name": "Music Player",
  "description": "Displays current track, artist, album art, and playback progress.",
  "version": "1.0.0",
  "category": "communication",
  "entry": "index.html",
  "bindings": [
    { "key": "music.trackName", "type": "string", "label": "Track Name" },
    { "key": "music.artistName", "type": "string", "label": "Artist Name" },
    { "key": "music.albumArt", "type": "string", "label": "Album Art" },
    { "key": "music.isPlaying", "type": "boolean", "label": "Playing" },
    { "key": "music.progress", "type": "number", "label": "Progress" },
    { "key": "music.duration", "type": "number", "label": "Duration", "unit": "s" }
  ],
  "triggers": [
    { "action": "show", "description": "Shows the music player." },
    { "action": "update", "description": "Updates playback state." }
  ],
  "ui": { "minWidth": 300, "minHeight": 120, "preferredWidth": 400, "preferredHeight": 200 }
}
