{
  "id": "appointments",
  "name": "Appointments",
  "description": "Displays upcoming appointments and highlights the next item.",
  "version": "1.0.0",
  "category": "general",
  "entry": "index.html",
  "bindings": [
    { "key": "appointments.list", "type": "array", "label": "Appointments" },
