{
  "id": "bp",
  "name": "Blood Pressure",
  "description": "Displays systolic and diastolic blood pressure.",
  "version": "1.0.0",
  "category": "health",
  "entry": "index.html",
  "bindings": [
    { "key": "health.bp.systolic", "type": "number", "label": "Systolic", "unit": "mmHg" },
    { "key": "health.bp.diastolic", "type": "number", "label": "Diastolic", "unit": "mmHg" },
    { "key": "health.bp.status", "type": "string", "label": "Status" }
  ],
  "triggers": [
    { "action": "highlight", "description": "Highlights abnormal pressure." }
  ],
  "ui": { "minWidth": 180, "minHeight": 150, "preferredWidth": 250, "preferredHeight": 200 }
}
