{
  "id": "hr",
  "name": "Heart Rate",
  "description": "Displays live heart rate and status.",
  "version": "1.0.0",
  "category": "health",
  "entry": "index.html",
  "bindings": [
    { "key": "health.heartrate.bpm", "type": "number", "label": "Heart Rate", "unit": "bpm" },
