{
  "id": "ecg",
  "name": "ECG",
  "description": "Displays ECG rhythm status and heart rate.",
  "version": "1.0.0",
  "category": "health",
  "entry": "index.html",
  "bindings": {
    "vitals.heart_rate": {
      "type": "number",
      "unit": "bpm",
      "description": "Current heart rate.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": 82
    },
    "vitals.unit": {
      "type": "string",
      "description": "Display unit for heart rate.",
      "default": "bpm",
      "source": "presentation"
    },
    "vitals.heart_rate_wave_scale": {
      "type": "number",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1,
      "source": "presentation"
    },
    "vitals.heart_rate_wave_duration": {
      "type": "number",
      "unit": "s",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1.35,
      "source": "presentation"
    },
    "vitals.ecg_status": {
      "type": "string",
      "description": "Current ECG status label.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": "Normal sinus"
    },
    "vitals.blood_pressure_systolic": {
      "type": "number",
      "unit": "mmHg",
      "description": "Current systolic blood pressure.",
      "source": "live",
      "staleAfterMs": 60000,
      "preview": 123
    },
    "vitals.blood_pressure_diastolic": {
      "type": "number",
      "unit": "mmHg",
      "description": "Current diastolic blood pressure.",
      "source": "live",
      "staleAfterMs": 60000,
      "preview": 78
    },
    "vitals.blood_pressure_unit": {
      "type": "string",
      "description": "Display unit for blood pressure.",
      "default": "mmHg",
      "source": "presentation"
    },
    "vitals.blood_pressure_wave_scale": {
      "type": "number",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1,
      "source": "presentation"
    },
    "vitals.blood_pressure_wave_duration": {
      "type": "number",
      "unit": "s",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1.45,
      "source": "presentation"
    },
    "vitals.spo2": {
      "type": "number",
      "unit": "%",
      "description": "Current oxygen saturation.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": 98
    },
    "vitals.spo2_unit": {
      "type": "string",
      "description": "Display unit for oxygen saturation.",
      "default": "%",
      "source": "presentation"
    },
    "vitals.spo2_wave_scale": {
      "type": "number",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1,
      "source": "presentation"
    },
    "vitals.spo2_wave_duration": {
      "type": "number",
      "unit": "s",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1.3,
      "source": "presentation"
    },
    "vitals.respiration_rate": {
      "type": "number",
      "unit": "rpm",
      "description": "Current respiration rate.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": 18
    },
    "vitals.respiration_unit": {
      "type": "string",
      "description": "Display unit for respiration rate.",
      "default": "rpm",
      "source": "presentation"
    },
    "vitals.respiration_wave_scale": {
      "type": "number",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1,
      "source": "presentation"
    },
    "vitals.respiration_wave_duration": {
      "type": "number",
      "unit": "s",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 3.8,
      "source": "presentation"
    },
    "vitals.ecg_samples": {
      "type": "array",
      "source": "live",
      "staleAfterMs": 2000,
      "description": "Timestamped ECG samples, each {timestamp: Unix milliseconds, value: number or null}. Never inferred from BPM."
    }
  },
  "ui": {
    "preferredSize": {
      "w": 316,
      "h": 197
    },
    "minSize": {
      "w": 316,
      "h": 197
    }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
