{
  "id": "hr",
  "name": "Heart Rate",
  "description": "Displays participant heart-rate data.",
  "version": "1.0.0",
  "category": "health",
  "entry": "index.html",
  "bindings": {
    "vitals.heart_rate": {
      "type": "number",
      "unit": "bpm",
      "description": "Current participant heart rate."
    },
    "vitals.heart_rate_min": {
      "type": "number",
      "unit": "bpm",
      "description": "Observed lower bound in the current window."
    },
    "vitals.heart_rate_max": {
      "type": "number",
      "unit": "bpm",
      "description": "Observed upper bound in the current window."
    },
    "vitals.heart_rate_wave_scale": {
      "type": "number",
      "description": "Vertical scale factor for the animated waveform.",
      "default": 1
    },
    "vitals.heart_rate_wave_duration": {
      "type": "number",
      "unit": "s",
      "description": "Horizontal animation duration for the waveform.",
      "default": 1.35
    },
    "vitals.unit": {
      "type": "string",
      "description": "Display unit for heart rate.",
      "default": "bpm"
    }
  },
  "ui": {
    "preferredSize": { "w": 95, "h": 65 },
    "minSize": { "w": 95, "h": 65 }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
