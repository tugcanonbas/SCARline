{
  "id": "spo2",
  "name": "SpO2",
  "description": "Displays current oxygen saturation.",
  "version": "1.0.0",
  "category": "health",
  "entry": "index.html",
  "bindings": {
    "vitals.spo2": {
      "type": "number",
      "unit": "%",
      "description": "Current oxygen saturation value.",
      "default": 98
    },
    "vitals.spo2_unit": {
      "type": "string",
      "description": "Display unit for oxygen saturation.",
      "default": "%"
    },
    "vitals.spo2_wave_scale": {
      "type": "number",
      "description": "Vertical scale factor for the animated pleth waveform.",
      "default": 1
    },
    "vitals.spo2_wave_duration": {
      "type": "number",
      "unit": "s",
      "description": "Horizontal animation duration for the pleth waveform.",
      "default": 1.3
    }
  },
  "ui": {
    "preferredSize": { "w": 95, "h": 65 },
    "minSize": { "w": 95, "h": 65 }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
