{
  "id": "spo2",
  "name": "SpO2",
  "description": "Displays current oxygen saturation.",
  "version": "1.0.0",
  "category": "health",
  "entry": "index.html",
  "bindings": {
    "vitals.spo2": {
      "type": "number",
      "unit": "%",
      "description": "Current oxygen saturation value.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": 98
    },
    "vitals.spo2_unit": {
      "type": "string",
      "description": "Display unit for oxygen saturation.",
      "default": "%",
      "source": "presentation"
    },
    "vitals.spo2_wave_scale": {
      "type": "number",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1,
      "source": "presentation"
    },
    "vitals.spo2_wave_duration": {
      "type": "number",
      "unit": "s",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1.3,
      "source": "presentation"
    }
  },
  "ui": {
    "preferredSize": {
      "w": 95,
      "h": 65
    },
    "minSize": {
      "w": 95,
      "h": 65
    }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
