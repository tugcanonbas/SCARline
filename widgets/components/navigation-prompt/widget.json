{
  "id": "navigation-prompt",
  "name": "Navigation Prompt",
  "description": "Displays the current driving instruction and next waypoint.",
  "version": "1.0.0",
  "category": "participant",
  "entry": "index.html",
  "bindings": {
    "navigation.current_instruction": {
      "type": "string",
      "description": "Current participant navigation prompt.",
      "default": "Keep right and prepare for the next junction."
    },
    "navigation.next_waypoint": {
      "type": "string",
      "description": "Next navigation waypoint label.",
      "default": "Next waypoint: North gate"
    },
    "navigation.route_label": {
      "type": "string",
      "description": "Current route label.",
      "default": "Route A"
    }
  },
  "ui": {
    "preferredSize": { "w": 316, "h": 129 },
    "minSize": { "w": 316, "h": 129 }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
