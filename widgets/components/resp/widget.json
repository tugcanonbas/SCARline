{
  "id": "resp",
  "name": "Respiration",
  "description": "Displays current respiration rate.",
  "version": "1.0.0",
  "category": "health",
  "entry": "index.html",
  "bindings": {
    "vitals.respiration_rate": {
      "type": "number",
      "unit": "rpm",
      "description": "Current respiration rate.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": 18
    },
    "vitals.respiration_unit": {
      "type": "string",
      "description": "Display unit for respiration rate.",
      "default": "rpm",
      "source": "presentation"
    },
    "vitals.respiration_wave_scale": {
      "type": "number",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1,
      "source": "presentation"
    },
    "vitals.respiration_wave_duration": {
      "type": "number",
      "unit": "s",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 3.8,
      "source": "presentation"
    }
  },
  "ui": {
    "preferredSize": {
      "w": 95,
      "h": 65
    },
    "minSize": {
      "w": 95,
      "h": 65
    }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
