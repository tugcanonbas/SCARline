{
  "id": "contactlist",
  "name": "Contact List",
  "description": "Displays a compact list of favorite contacts.",
  "version": "1.0.0",
  "category": "communication",
  "entry": "index.html",
  "bindings": {
    "contacts.item_1_name": {
      "type": "string",
      "description": "First contact name.",
      "default": "Susan Smith"
    },
    "contacts.item_1_phone": {
      "type": "string",
      "description": "First contact phone.",
      "default": "+49 1234 567890"
    },
    "contacts.item_2_name": {
      "type": "string",
      "description": "Second contact name.",
      "default": "Carlos Garcia"
    },
    "contacts.item_2_phone": {
      "type": "string",
      "description": "Second contact phone.",
      "default": "+49 221 555 814"
    },
    "contacts.item_3_name": {
      "type": "string",
      "description": "Third contact name.",
      "default": "Bianca Davis"
    },
    "contacts.item_3_phone": {
      "type": "string",
      "description": "Third contact phone.",
      "default": "+49 30 884 229"
    },
    "contacts.item_4_name": {
      "type": "string",
      "description": "Fourth contact name.",
      "default": "Adam Friedman"
    },
    "contacts.item_4_phone": {
      "type": "string",
      "description": "Fourth contact phone.",
      "default": "+49 711 404 770"
    }
  },
  "actions": {
    "contacts.select_1": {
      "description": "Select the first contact.",
      "interactionType": "click"
    },
    "contacts.select_2": {
      "description": "Select the second contact.",
      "interactionType": "click"
    },
    "contacts.select_3": {
      "description": "Select the third contact.",
      "interactionType": "click"
    },
    "contacts.select_4": {
      "description": "Select the fourth contact.",
      "interactionType": "click"
    }
  },
  "ui": {
    "preferredSize": { "w": 150, "h": 197 },
    "minSize": { "w": 150, "h": 197 }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
