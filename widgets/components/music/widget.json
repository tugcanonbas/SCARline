{
  "id": "music",
  "name": "Music",
  "description": "Displays media playback and exposes playback controls.",
  "version": "1.0.0",
  "category": "communication",
  "entry": "index.html",
  "bindings": {
    "media.track_title": {
      "type": "string",
      "description": "Current track title."
    },
    "media.artist": {
      "type": "string",
      "description": "Current track artist."
    },
    "media.album": {
      "type": "string",
      "description": "Current track album."
    },
    "media.progress_label": {
      "type": "string",
      "description": "Current playback position."
    },
    "media.duration_label": {
      "type": "string",
      "description": "Total track duration."
    },
    "media.progress_ratio": {
      "type": "number",
      "unit": "%",
      "description": "Playback progress percentage."
    },
    "media.is_playing": {
      "type": "boolean",
      "description": "Whether playback is active."
    }
  },
  "actions": {
    "media.shuffle": {
      "description": "Toggle shuffle mode.",
      "interactionType": "click"
    },
    "media.previous": {
      "description": "Play previous track.",
      "interactionType": "click"
    },
    "media.play_pause": {
      "description": "Toggle playback.",
      "interactionType": "click"
    },
    "media.next": {
      "description": "Play next track.",
      "interactionType": "click"
    },
    "media.repeat": {
      "description": "Toggle repeat mode.",
      "interactionType": "click"
    }
  },
  "ui": {
    "preferredSize": { "w": 316, "h": 197 },
    "minSize": { "w": 316, "h": 197 }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
