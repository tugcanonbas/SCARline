{
  "id": "sensor-health",
  "name": "Sensor Health",
  "description": "Displays the current runtime status of attached sensors.",
  "version": "1.0.0",
  "category": "study",
  "entry": "index.html",
  "bindings": {
    "sensor.streaming_label": {
      "type": "string",
      "description": "Streaming status summary.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": "3/4 sensors streaming"
    },
    "sensor.issue_label": {
      "type": "string",
      "description": "Issue summary label.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": "No issues detected"
    },
    "sensor.summary_1": {
      "type": "string",
      "description": "First sensor detail line.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": "Front Camera \u00b7 streaming"
    },
    "sensor.summary_2": {
      "type": "string",
      "description": "Second sensor detail line.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": "GNSS \u00b7 streaming"
    },
    "sensor.summary_3": {
      "type": "string",
      "description": "Third sensor detail line.",
      "source": "live",
      "staleAfterMs": 5000,
      "preview": "IMU \u00b7 degraded"
    }
  },
  "ui": {
    "preferredSize": {
      "w": 316,
      "h": 197
    },
    "minSize": {
      "w": 316,
      "h": 197
    }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
