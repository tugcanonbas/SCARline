{
  "id": "sensor-health",
  "name": "Sensor Health",
  "description": "Displays the current runtime status of attached sensors.",
  "version": "1.0.0",
  "category": "study",
  "entry": "index.html",
  "bindings": {
    "sensor.streaming_label": {
      "type": "string",
      "description": "Streaming status summary.",
      "default": "3/4 sensors streaming"
    },
    "sensor.issue_label": {
      "type": "string",
      "description": "Issue summary label.",
      "default": "No issues detected"
    },
    "sensor.summary_1": {
      "type": "string",
      "description": "First sensor detail line.",
      "default": "Front Camera · streaming"
    },
    "sensor.summary_2": {
      "type": "string",
      "description": "Second sensor detail line.",
      "default": "GNSS · streaming"
    },
    "sensor.summary_3": {
      "type": "string",
      "description": "Third sensor detail line.",
      "default": "IMU · degraded"
    }
  },
  "ui": {
    "preferredSize": { "w": 316, "h": 197 },
    "minSize": { "w": 316, "h": 197 }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
