{
  "id": "activecall",
  "name": "Active Call",
  "description": "Displays an active call with call controls.",
  "version": "1.0.0",
  "category": "communication",
  "entry": "index.html",
  "bindings": {
    "call.caller_name": {
      "type": "string",
      "description": "Active caller name.",
      "default": "Susan Smith"
    },
    "call.caller_phone": {
      "type": "string",
      "description": "Active caller phone number.",
      "default": "+49 1234 567890"
    },
    "call.status_label": {
      "type": "string",
      "description": "Current active call status label.",
      "default": "Active Call"
    },
    "call.duration_label": {
      "type": "string",
      "description": "Elapsed call duration.",
      "default": "4:32"
    },
    "call.note_label": {
      "type": "string",
      "description": "Supplemental active call label.",
      "default": "Secure line"
    },
    "call.audio_route_label": {
      "type": "string",
      "description": "Current call audio route label.",
      "default": "Bluetooth"
    },
    "call.is_bluetooth": {
      "type": "boolean",
      "description": "Whether Bluetooth audio is active.",
      "default": true
    },
    "call.is_speaker": {
      "type": "boolean",
      "description": "Whether speaker mode is active.",
      "default": false
    },
    "call.is_muted": {
      "type": "boolean",
      "description": "Whether the call is muted.",
      "default": false
    },
    "call.is_on_hold": {
      "type": "boolean",
      "description": "Whether the call is on hold.",
      "default": false
    }
  },
  "actions": {
    "call.add": {
      "description": "Add another participant to the call.",
      "interactionType": "click"
    },
    "call.hold": {
      "description": "Toggle hold mode.",
      "interactionType": "click"
    },
    "call.bluetooth": {
      "description": "Toggle Bluetooth audio route.",
      "interactionType": "click"
    },
    "call.speaker": {
      "description": "Toggle speaker mode.",
      "interactionType": "click"
    },
    "call.mute": {
      "description": "Toggle mute mode.",
      "interactionType": "click"
    },
    "call.keypad": {
      "description": "Open the call keypad.",
      "interactionType": "click"
    },
    "call.hangup": {
      "description": "End the active call.",
      "interactionType": "click"
    }
  },
  "ui": {
    "preferredSize": { "w": 150, "h": 197 },
    "minSize": { "w": 150, "h": 197 }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
