{
  "id": "bp",
  "name": "Blood Pressure",
  "description": "Displays current blood pressure.",
  "version": "1.0.0",
  "category": "health",
  "entry": "index.html",
  "bindings": {
    "vitals.blood_pressure_systolic": {
      "type": "number",
      "unit": "mmHg",
      "description": "Current systolic blood pressure value.",
      "source": "live",
      "staleAfterMs": 60000,
      "preview": 123
    },
    "vitals.blood_pressure_diastolic": {
      "type": "number",
      "unit": "mmHg",
      "description": "Current diastolic blood pressure value.",
      "source": "live",
      "staleAfterMs": 60000,
      "preview": 78
    },
    "vitals.blood_pressure_unit": {
      "type": "string",
      "description": "Display unit for blood pressure.",
      "default": "mmHg",
      "source": "presentation"
    },
    "vitals.blood_pressure_wave_scale": {
      "type": "number",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1,
      "source": "presentation"
    },
    "vitals.blood_pressure_wave_duration": {
      "type": "number",
      "unit": "s",
      "description": "Legacy presentation setting; received sample plots use their timestamps and values.",
      "default": 1.45,
      "source": "presentation"
    }
  },
  "ui": {
    "preferredSize": {
      "w": 95,
      "h": 65
    },
    "minSize": {
      "w": 95,
      "h": 65
    }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
