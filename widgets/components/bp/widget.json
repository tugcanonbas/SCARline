{
  "id": "bp",
  "name": "Blood Pressure",
  "description": "Displays current blood pressure.",
  "version": "1.0.0",
  "category": "biometrics",
  "entry": "index.html",
  "bindings": {
    "vitals.blood_pressure_systolic": {
      "type": "number",
      "unit": "mmHg",
      "description": "Current systolic blood pressure value.",
      "default": 123
    },
    "vitals.blood_pressure_diastolic": {
      "type": "number",
      "unit": "mmHg",
      "description": "Current diastolic blood pressure value.",
      "default": 78
    },
    "vitals.blood_pressure_unit": {
      "type": "string",
      "description": "Display unit for blood pressure.",
      "default": "mmHg"
    },
    "vitals.blood_pressure_wave_scale": {
      "type": "number",
      "description": "Vertical scale factor for the animated pressure waveform.",
      "default": 1
    },
    "vitals.blood_pressure_wave_duration": {
      "type": "number",
      "unit": "s",
      "description": "Horizontal animation duration for the pressure waveform.",
      "default": 1.45
    }
  },
  "ui": {
    "preferredSize": { "w": 95, "h": 65 },
    "minSize": { "w": 95, "h": 65 }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
