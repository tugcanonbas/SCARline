{
  "id": "speedometer",
  "name": "Speedometer",
  "description": "Displays the current vehicle speed and speed limit.",
  "version": "1.0.0",
  "category": "driving",
  "entry": "index.html",
  "bindings": {
    "vehicle.speed": {
      "type": "number",
      "unit": "km/h",
      "description": "Current vehicle speed."
    },
    "vehicle.speed_limit": {
      "type": "number",
      "unit": "km/h",
      "description": "Current road speed limit."
    },
    "vehicle.speed_ratio": {
      "type": "number",
      "unit": "%",
      "description": "Current speed as a percentage of the speed limit."
    },
    "vehicle.speed_arc_offset": {
      "type": "number",
      "description": "Stroke offset for the animated gauge arc."
    },
    "vehicle.speed_unit": {
      "type": "string",
      "description": "Display unit for speed.",
      "default": "km/h"
    }
  },
  "ui": {
    "preferredSize": { "w": 150, "h": 129 },
    "minSize": { "w": 150, "h": 129 }
  },
  "window": {
    "frame": "none",
    "transparent": true
  }
}
