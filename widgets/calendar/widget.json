{
  "id": "calendar",
  "name": "Calendar",
  "description": "Displays a compact calendar date and upcoming events.",
  "version": "1.0.0",
  "category": "general",
  "entry": "index.html",
  "bindings": [
    { "key": "calendar.currentDate", "type": "string", "label": "Current Date" },
    { "key": "calendar.events", "type": "array", "label": "Events" }
  ],
  "triggers": [
    { "action": "show", "description": "Shows the calendar." }
  ],
  "ui": { "minWidth": 250, "minHeight": 300, "preferredWidth": 350, "preferredHeight": 400 }
}
