{
  "id": "callended",
  "name": "Call Ended",
  "description": "Displays a call-ended summary notification.",
  "version": "1.0.0",
  "category": "communication",
  "entry": "index.html",
  "bindings": [
    { "key": "call.callerName", "type": "string", "label": "Caller Name" },
    { "key": "call.totalDuration", "type": "number", "label": "Total Duration", "unit": "s" },
    { "key": "call.endReason", "type": "string", "label": "End Reason" }
  ],
  "triggers": [
    { "action": "show", "description": "Shows call-ended summary." },
    { "action": "hide", "description": "Hides call-ended summary." }
  ],
  "ui": { "minWidth": 300, "minHeight": 150, "preferredWidth": 400, "preferredHeight": 200 }
}
