# PostgreSQL secrets
POSTGRES_PASSWORD=scarline

# RabbitMQ secrets
RABBITMQ_DEFAULT_PASS=scarline

# CoreAPI authentication secrets
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# CoreAPI one-time administrator secret
# Used only when the users table is empty. Change it after the first login.
BOOTSTRAP_ADMIN_PASSWORD=scarline

# Overlay control authentication secret
OVERLAY_CONTROL_SECRET=replace-with-at-least-32-random-characters

# Simulator adapter authentication secret
SIM_BRIDGE_ADAPTER_SECRET=replace-with-at-least-32-random-characters
